<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <OutputType>WinExe</OutputType>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <UseWPF>true</UseWPF>

	  <NeutralLanguage>en</NeutralLanguage>
	  <TargetFramework>net10.0-windows</TargetFramework>
	  <ApplicationManifest>GameBalance.manifest</ApplicationManifest>
	  <PlatformTarget>x64</PlatformTarget>

	  <PublishSingleFile>true</PublishSingleFile>
	  <SelfContained>true</SelfContained>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <IncludeNativeLibrariesInSingleFile>true</IncludeNativeLibrariesInSingleFile>
	  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

	  <Version>1.0.0</Version>
	  <AssemblyVersion>1.0.0</AssemblyVersion>
	  <FileVersion>1.0.0</FileVersion>

	  <ApplicationIcon>Assets\Icons\GameBoost.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Icons\GameBoost.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\GameBoost.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Images\" />
    <Folder Include="Features\Dock\" />
    <Folder Include="Infrastructure\FileSystem\File\" />
    <Folder Include="Infrastructure\FileSystem\Directory\" />
    <Folder Include="Infrastructure\Services\" />
    <Folder Include="MVVM\Utilities\Converters\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

</Project>
