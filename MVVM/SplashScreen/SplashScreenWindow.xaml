<Window
    x:Class="GameBalance.MVVM.SplashScreen.SplashScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assists="clr-namespace:GameBalance.MVVM.Utilities.Assists"
    xmlns:behaviours="clr-namespace:GameBalance.MVVM.Utilities.Behaviors"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBalance.MVVM.SplashScreen"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBalance.MVVM.UserControls.Shared.Controls"
    Title="GameBalance Loading"
    Width="600"
    Height="400"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border Style="{StaticResource ApplicationBorderStyle}">
        <Grid>

            <!--#region Windows Caption Button-->
            <controls:WindowCaptionButton
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="Close"
                Style="{StaticResource CaptionButtonStyle}" />
            <!--#endregion-->

            <!--#region Pulse Icon-->
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity=".1">

                <Border
                    Width="200"
                    Height="25"
                    Margin="0,0,-424,-50"
                    Background="{StaticResource IconBrush}" />
                <Border
                    Width="200"
                    Height="25"
                    Margin="-424,50,0,0"
                    Background="{StaticResource IconBrush}" />

                <materialDesign:PackIcon
                    Width="300"
                    Height="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IconBrush}"
                    Kind="Pulse" />
            </Grid>
            <!--#endregion-->

            <!--#region Title Text-->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                    FontSize="53"
                    FontWeight="ExtraBold"
                    Style="{StaticResource TitleStyle}"
                    Text="GameBalance"
                    TextAlignment="Center" />
                <TextBlock
                    Style="{StaticResource SubTitleStyle}"
                    Text="Windows 11 Optimisation Tool"
                    TextAlignment="Center" />
            </StackPanel>
            <!--#endregion-->

            <!--#region Progress UI-->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <StackPanel>
                    <ui:CircularProgressIndicator Margin="{StaticResource SeparatorBottomPadding}" Value="{Binding ProgressPercentage}" />
                    <TextBlock Style="{StaticResource SubTitleStyle}" Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>
            <!--#endregion-->

        </Grid>
    </Border>
</Window>
