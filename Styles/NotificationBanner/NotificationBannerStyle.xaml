<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="clr-namespace:GameBalance.MVVM.Utilities.Behaviors"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style BasedOn="{StaticResource {x:Type controls:InfoCardControl}}" TargetType="{x:Type controls:NotificationBannerControl}">

        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="InfoState" Value="{Binding NotificationItem.State, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="IsInteractive" Value="True" />
        <Setter Property="Margin" Value="-10,0,-10,0" />
        <Setter Property="CardPadding" Value="30 0" />

        <Setter Property="Command" Value="{Binding NotificationItem.Command, RelativeSource={RelativeSource TemplatedParent}}" />

        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="Auto" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NotificationBannerControl}">

                    <Border
                        Padding="{TemplateBinding CardPadding}"
                        Background="{TemplateBinding CurrentBackground}"
                        BorderBrush="{TemplateBinding CurrentBorder}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <controls:LabelledIconControl
                                HorizontalAlignment="Left"
                                IconKind="{TemplateBinding IconKind}"
                                Text="{Binding NotificationItem.DisplayTitle, RelativeSource={RelativeSource TemplatedParent}}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource ButtonTitleStyle}"
                                Text="{Binding NotificationItem.Message, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center" />

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Opacity=".2"
                                Style="{StaticResource ButtonTitleStyle}"
                                Text="Click to close" />
                        </Grid>


                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="NotificationItem" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>