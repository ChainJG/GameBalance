<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <Style BasedOn="{StaticResource {x:Type controls:InteractiveCard}}" TargetType="{x:Type controls:InteractiveIconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CardPadding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IconKind" Value="Help" />
        <Setter Property="IconSize" Value="16" />
        <Setter Property="ScaleOnHover" Value="True" />
        <Setter Property="HoverScaleFactor" Value="1.1" />
        <Setter Property="ScaleOnPress" Value="True" />
        <Setter Property="PressScaleFactor" Value="0.85" />
        <Setter Property="NormalElevation" Value="0" />
        <Setter Property="HoverElevation" Value="2" />
        <Setter Property="PressedElevation" Value="4" />
        <Setter Property="SelectedElevation" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InteractiveIconButton}">
                    <Grid>
                        <!-- Shadow Layer -->
                        <Canvas x:Name="PART_ShadowCanvas" Opacity="0">
                            <Border 
                                x:Name="PART_Shadow"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                Effect="{StaticResource ShadowEffect}" />
                        </Canvas>

                        <!-- Main Border -->
                        <Border 
                            x:Name="PART_Border"
                            Padding="{TemplateBinding CardPadding}"
                            Background="{TemplateBinding CurrentBackground}"
                            BorderBrush="{TemplateBinding CurrentBorder}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>

                            <!-- Icon -->
                            <materialDesign:PackIcon
                                x:Name="PART_Icon"
                                Width="{TemplateBinding IconSize}"
                                Height="{TemplateBinding IconSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource IconBrush}"
                                IsHitTestVisible="False"
                                Kind="{TemplateBinding IconKind}"
                                RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <ScaleTransform />
                                </materialDesign:PackIcon.RenderTransform>
                            </materialDesign:PackIcon>
                        </Border>

                        <!-- Focus Border -->
                        <Border 
                            x:Name="PART_FocusBorder"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CornerRadiusAddConverter}, ConverterParameter=1}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Normal State - Shadow Hidden -->
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Hover State - Show Shadow & Scale Icon -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_ShadowCanvas" 
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" 
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="{Binding HoverScaleFactor, RelativeSource={RelativeSource TemplatedParent}}" 
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="{Binding HoverScaleFactor, RelativeSource={RelativeSource TemplatedParent}}" 
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_ShadowCanvas" 
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Pressed State - Scale Down Icon & Border -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="{Binding PressScaleFactor, RelativeSource={RelativeSource TemplatedParent}}" 
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="{Binding PressScaleFactor, RelativeSource={RelativeSource TemplatedParent}}" 
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.95" 
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.95" 
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected State - Scale Icon & Change Color -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1.15" 
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1.15" 
                                            Duration="0:0:0.2" />
                                        <ColorAnimation 
                                            Storyboard.TargetName="PART_Icon" 
                                            Storyboard.TargetProperty="Foreground.Color"
                                            To="{Binding Source={StaticResource AccentBrush}, Path=Color}" 
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Icon" Property="Opacity" Value="0.4" />
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Focus State -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="PART_FocusBorder" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Hide shadow when HasShadow is false -->
                        <Trigger Property="HasShadow" Value="False">
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>