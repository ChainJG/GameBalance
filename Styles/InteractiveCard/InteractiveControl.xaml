<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <Style TargetType="{x:Type controls:InteractiveCard}">

        <!--  Default Card Theme  -->
        <Setter Property="NormalBackground" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource CardBackgroundHoverBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource CardBackgroundPressedBrush}" />
        <Setter Property="SelectedBackground" Value="{DynamicResource CardBackgroundSelectedBrush}" />
        <Setter Property="DisabledBackground" Value="{DynamicResource DisabledCardBackgroundBrush}" />

        <Setter Property="NormalBorder" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="HoverBorder" Value="{DynamicResource CardBorderHoverBrush}" />
        <Setter Property="PressedBorder" Value="{DynamicResource CardBorderPressedBrush}" />
        <Setter Property="SelectedBorder" Value="{DynamicResource CardBorderSelectedBrush}" />
        <Setter Property="DisabledBorder" Value="{DynamicResource DisabledCardBorderBrush}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:InteractiveCard}">

                    <Border
                        Padding="{TemplateBinding CardPadding}"
                        Background="{TemplateBinding CurrentBackground}"
                        BorderBrush="{TemplateBinding CurrentBorder}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter />

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>