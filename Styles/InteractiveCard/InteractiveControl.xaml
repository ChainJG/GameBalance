<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls">

    <Style TargetType="{x:Type controls:InteractiveControl}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="BaseShadowDepth" Value="5" />
        <Setter Property="BaseShadowOpacity" Value="0.3" />
        <Setter Property="ShadowMatchesBackground" Value="True" />
        <Setter Property="NormalElevation" Value="0" />
        <Setter Property="HoverElevation" Value="4" />
        <Setter Property="PressedElevation" Value="8" />
        <Setter Property="SelectedElevation" Value="2" />
        <Setter Property="FocusedElevation" Value="2" />
        <Setter Property="AreAnimationsEnabled" Value="True" />
        <Setter Property="AnimationDuration" Value="0:0:0.2" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InteractiveControl}">
                    <Grid>
                        <!-- Shadow Layer -->
                        <Canvas x:Name="PART_ShadowCanvas" Opacity="0">
                            <Border 
                                x:Name="PART_Shadow"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                Effect="{StaticResource ShadowEffect}" />
                        </Canvas>

                        <!-- Main Border -->
                        <Border 
                            x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding CurrentBackground}"
                            BorderBrush="{TemplateBinding CurrentBorder}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>

                            <ContentPresenter 
                                x:Name="PART_Content"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Opacity="1" />
                        </Border>

                        <!-- Focus Border -->
                        <Border 
                            x:Name="PART_FocusBorder"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CornerRadiusAddConverter}, ConverterParameter=1}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Normal State - Shadow Hidden -->
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Hover State - Show Shadow -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_ShadowCanvas" 
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" 
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_ShadowCanvas" 
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" 
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Pressed State - Scale Down -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.98" 
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.98" 
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PART_Border" 
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" 
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Content" Property="Opacity" Value="0.5" />
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Focus State -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="PART_FocusBorder" Property="Opacity" Value="0" />
                        </Trigger>

                        <!-- Hide shadow when HasShadow is false -->
                        <Trigger Property="HasShadow" Value="False">
                            <Setter TargetName="PART_ShadowCanvas" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>