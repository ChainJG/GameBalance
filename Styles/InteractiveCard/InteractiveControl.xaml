<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <Style TargetType="{x:Type controls:InteractiveCard}">

        <!--  Default Card Theme  -->
        <Setter Property="NormalBackground" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource PrimaryButtonBackgroundHoverBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource PrimaryButtonBackgroundPressedBrush}" />
        <Setter Property="SelectedBackground" Value="{DynamicResource PrimaryButtonBackgroundSelectedBrush}" />
        <Setter Property="DisabledBackground" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />

        <Setter Property="NormalBorder" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="HoverBorder" Value="{DynamicResource PrimaryButtonBorderHoverBrush}" />
        <Setter Property="PressedBorder" Value="{DynamicResource PrimaryButtonBorderPressedBrush}" />
        <Setter Property="SelectedBorder" Value="{DynamicResource PrimaryButtonBorderSelectedBrush}" />
        <Setter Property="DisabledBorder" Value="{DynamicResource ButtonDisabledBorderBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InteractiveCard}">
                    <Border
                        Padding="{TemplateBinding CardPadding}"
                        Background="{TemplateBinding CurrentBackground}"
                        BorderBrush="{TemplateBinding CurrentBorder}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter />

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>