<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls">

    <Style TargetType="{x:Type controls:InteractiveCard}">

        <Setter Property="CornerRadius" Value="{StaticResource BorderCornerRadius}" />
        <Setter Property="CardPadding" Value="{StaticResource BorderPadding}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:InteractiveCard}">

                    <Border
                        Padding="{TemplateBinding CardPadding}"
                        Background="{TemplateBinding CurrentBackground}"
                        BorderBrush="{TemplateBinding CurrentBorder}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>