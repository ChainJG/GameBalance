<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!--#region Font Family-->

    <FontFamily x:Key="DefaultGameBalanceFontFamily">Calibri</FontFamily>
    <FontFamily x:Key="ButtonFontFamily">Calibri Light</FontFamily>

    <!--#endregion-->

    <!--#region Font Size-->

    <System:Double x:Key="DefaultFontSize">11</System:Double>
    <System:Double x:Key="TitleFontSize">23</System:Double>
    <System:Double x:Key="SubTitleFontSize">13</System:Double>
    <System:Double x:Key="ButtonFontSize">13</System:Double>

    <!--#endregion-->

</ResourceDictionary>