<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect
        x:Key="ShadowEffect"
        BlurRadius="5"
        Direction="270"
        Opacity="0.3"
        ShadowDepth="2"
        Color="Black" />

    <QuadraticEase x:Key="EaseOutQuad" EasingMode="EaseOut" />
    <BackEase
        x:Key="EaseOutBack"
        Amplitude="0.5"
        EasingMode="EaseOut" />

    <Color x:Key="DefaultShadowColor">#000000</Color>

</ResourceDictionary>