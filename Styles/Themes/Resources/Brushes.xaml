<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--#region Core Application Surfaces-->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColour}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource TitleBarBackgroundColour}" />

    <SolidColorBrush x:Key="PrimaryPanelBrush" Color="{DynamicResource PrimaryPanelColour}" />
    <SolidColorBrush x:Key="SecondaryPanelBrush" Color="{DynamicResource SecondaryPanelColour}" />
    <SolidColorBrush x:Key="OverlayPanelBrush" Color="{DynamicResource OverlayPanelColour}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColour}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource PageBackgroundColour}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource PanelBorderColour}" />
    <SolidColorBrush x:Key="PanelDividerBrush" Color="{DynamicResource PanelDividerColour}" />

    <!--#endregion-->

    <!--#region Text Brushes-->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColour}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColour}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColour}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColour}" />

    <!--#endregion-->

    <!--#region Brand / Accent Brushes-->

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColour}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColour}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColour}" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="{DynamicResource AccentDisabledColour}" />

    <!--#endregion-->

    <!--#region Icon Brushes-->

    <SolidColorBrush x:Key="IconBrush" Color="{DynamicResource IconColor}" />
    <SolidColorBrush x:Key="IconDisabledBrush" Color="{DynamicResource IconDisabledColour}" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColour}" />

    <!--#endregion-->

    <!--#region Status Brushes-->

    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColour}" />
    <SolidColorBrush x:Key="RecommendedBrush" Color="{DynamicResource RecommendedColour}" />
    <SolidColorBrush x:Key="OptimisedStatusBrush" Color="{DynamicResource OptimisedStatusColour}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColour}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{DynamicResource CautionColour}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColour}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColour}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{DynamicResource CriticalColour}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColour}" />
    <SolidColorBrush x:Key="NoticeBrush" Color="{DynamicResource NoticeColour}" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{DynamicResource UnknownColour}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColour}" />

    <!--#endregion-->

    <!--#region Card Brushes-->

    <!--  ================================================  -->
    <!--  Information  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Information.Normal.Background" Color="{DynamicResource InfoCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Hover.Background" Color="{DynamicResource InfoCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Pressed.Background" Color="{DynamicResource InfoCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Selected.Background" Color="{DynamicResource InfoCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Information.Normal.Border" Color="{DynamicResource InfoCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Hover.Border" Color="{DynamicResource InfoCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Pressed.Border" Color="{DynamicResource InfoCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Information.Selected.Border" Color="{DynamicResource InfoCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Running  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Running.Normal.Background" Color="{DynamicResource RunningCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Hover.Background" Color="{DynamicResource RunningCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Pressed.Background" Color="{DynamicResource RunningCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Selected.Background" Color="{DynamicResource RunningCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Running.Normal.Border" Color="{DynamicResource RunningCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Hover.Border" Color="{DynamicResource RunningCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Pressed.Border" Color="{DynamicResource RunningCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Running.Selected.Border" Color="{DynamicResource RunningCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Recommended  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Recommended.Normal.Background" Color="{DynamicResource RecommendedCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Hover.Background" Color="{DynamicResource RecommendedCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Pressed.Background" Color="{DynamicResource RecommendedCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Selected.Background" Color="{DynamicResource RecommendedCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Recommended.Normal.Border" Color="{DynamicResource RecommendedCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Hover.Border" Color="{DynamicResource RecommendedCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Pressed.Border" Color="{DynamicResource RecommendedCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Recommended.Selected.Border" Color="{DynamicResource RecommendedCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Success  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Successful.Normal.Background" Color="{DynamicResource SuccessCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Hover.Background" Color="{DynamicResource SuccessCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Pressed.Background" Color="{DynamicResource SuccessCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Selected.Background" Color="{DynamicResource SuccessCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Successful.Normal.Border" Color="{DynamicResource SuccessCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Hover.Border" Color="{DynamicResource SuccessCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Pressed.Border" Color="{DynamicResource SuccessCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Successful.Selected.Border" Color="{DynamicResource SuccessCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Warning  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Warning.Normal.Background" Color="{DynamicResource WarningCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Hover.Background" Color="{DynamicResource WarningCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Pressed.Background" Color="{DynamicResource WarningCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Selected.Background" Color="{DynamicResource WarningCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Warning.Normal.Border" Color="{DynamicResource WarningCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Hover.Border" Color="{DynamicResource WarningCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Pressed.Border" Color="{DynamicResource WarningCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Warning.Selected.Border" Color="{DynamicResource WarningCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Caution  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Caution.Normal.Background" Color="{DynamicResource CautionCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Hover.Background" Color="{DynamicResource CautionCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Pressed.Background" Color="{DynamicResource CautionCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Selected.Background" Color="{DynamicResource CautionCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Caution.Normal.Border" Color="{DynamicResource CautionCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Hover.Border" Color="{DynamicResource CautionCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Pressed.Border" Color="{DynamicResource CautionCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Caution.Selected.Border" Color="{DynamicResource CautionCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Error  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Error.Normal.Background" Color="{DynamicResource ErrorCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Hover.Background" Color="{DynamicResource ErrorCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Pressed.Background" Color="{DynamicResource ErrorCardBackgroundPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Selected.Background" Color="{DynamicResource ErrorCardBackgroundSelectedColour}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="InfoCard.Error.Normal.Border" Color="{DynamicResource ErrorCardBorderColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Hover.Border" Color="{DynamicResource ErrorCardBorderHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Pressed.Border" Color="{DynamicResource ErrorCardBorderPressedColour}" />
    <SolidColorBrush x:Key="InfoCard.Error.Selected.Border" Color="{DynamicResource ErrorCardBorderSelectedColour}" />

    <!--  ================================================  -->
    <!--  Notice  -->
    <!--  ================================================  -->

    <!--  Background  -->
    <SolidColorBrush x:Key="InfoCard.Notice.Normal.Background" Color="{DynamicResource NoticeCardBackgroundColour}" />
    <SolidColorBrush x:Key="InfoCard.Notice.Hover.Background" Color="{DynamicResource NoticeCardBackgroundHoverColour}" />
    <SolidColorBrush x:Key="InfoCard.Notice.Pressed.Background" Color="{DynamicResource NoticeCardBackgroundPressedColour}" />
