    <SolidColorBrush x:Key="InfoCard.Notice.Selected.Border" Color="{DynamicResource NoticeCardBorderSelectedColour}" />

    <!--#endregion-->

    <!--#region Button Colours-->

    <!--  Default transparent glass button  -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackgroundColour}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ButtonBorderColour}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColour}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{DynamicResource ButtonPressedColour}" />
    <SolidColorBrush x:Key="ButtonIsCheckedBrush" Color="{DynamicResource ButtonIsCheckedColour}" />

    <!--  Primary button  -->
    <!--  Background  -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{DynamicResource PrimaryButtonBackgroundColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundHoverBrush" Color="{DynamicResource PrimaryButtonBackgroundHoverColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundPressedBrush" Color="{DynamicResource PrimaryButtonBackgroundPressedColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundSelectedBrush" Color="{DynamicResource PrimaryButtonBackgroundSelectedColour}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{DynamicResource PrimaryButtonForegroundColour}" />

    <!--  Background  -->
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{DynamicResource PrimaryButtonBorderColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderHoverBrush" Color="{DynamicResource PrimaryButtonBorderHoverColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderPressedBrush" Color="{DynamicResource PrimaryButtonBorderPressedColour}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderSelectedBrush" Color="{DynamicResource PrimaryButtonBorderSelectedColour}" />

    <!--  Secondary button  -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{DynamicResource SecondaryButtonBackgroundColour}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{DynamicResource SecondaryButtonHoverColour}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="{DynamicResource SecondaryButtonPressedColour}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{DynamicResource SecondaryButtonBorderColour}" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="{DynamicResource SecondaryButtonForegroundColour}" />

    <!--  Error button  -->
    <SolidColorBrush x:Key="ErrorButtonBackgroundBrush" Color="{DynamicResource ErrorButtonBackgroundColour}" />
    <SolidColorBrush x:Key="ErrorButtonHoverBrush" Color="{DynamicResource ErrorButtonHoverColour}" />
    <SolidColorBrush x:Key="ErrorButtonPressedBrush" Color="{DynamicResource ErrorButtonPressedColour}" />
    <SolidColorBrush x:Key="ErrorButtonBorderBrush" Color="{DynamicResource ErrorButtonBorderColour}" />
    <SolidColorBrush x:Key="ErrorButtonForegroundBrush" Color="{DynamicResource ErrorButtonForegroundColour}" />

    <!--  Success button  -->
    <SolidColorBrush x:Key="SuccessButtonBackgroundBrush" Color="{DynamicResource SuccessButtonBackgroundColour}" />
    <SolidColorBrush x:Key="SuccessButtonHoverBrush" Color="{DynamicResource SuccessButtonHoverColour}" />
    <SolidColorBrush x:Key="SuccessButtonPressedBrush" Color="{DynamicResource SuccessButtonPressedColour}" />
    <SolidColorBrush x:Key="SuccessButtonBorderBrush" Color="{DynamicResource SuccessButtonBorderColour}" />
    <SolidColorBrush x:Key="SuccessButtonForegroundBrush" Color="{DynamicResource SuccessButtonForegroundColour}" />

    <!--  Disabled button  -->
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="{DynamicResource ButtonDisabledBackgroundColour}" />
    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="{DynamicResource ButtonDisabledBorderColour}" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="{DynamicResource ButtonDisabledForegroundColour}" />
    <!--#endregion-->

    <!--#region Progress / Loading Colours-->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{DynamicResource ProgressTrackColour}" />
    <SolidColorBrush x:Key="ProgressFillBrush" Color="{DynamicResource ProgressFillColour}" />
    <SolidColorBrush x:Key="ProgressTrackHoverBrush" Color="{DynamicResource ProgressTrackHoverColour}" />
    <SolidColorBrush x:Key="ProgressBorderHoverBrush" Color="{DynamicResource ProgressBorderHoverColour}" />
    <!--#endregion-->

    <!--#region Tooltip Colours-->
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{DynamicResource ToolTipBackgroundColour}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource ToolTipBorderColour}" />
    <!--#endregion-->

</ResourceDictionary>