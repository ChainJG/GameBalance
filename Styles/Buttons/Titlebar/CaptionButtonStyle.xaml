<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls">

    <Style
        x:Key="CaptionButtonStyle"
        BasedOn="{StaticResource {x:Type controls:InteractiveIconButton}}"
        TargetType="{x:Type controls:WindowCaptionButton}">

        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="NormalBackground" Value="Transparent" />
        <Setter Property="NormalBorder" Value="Transparent" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="ToolTipText" Value="{Binding Command, RelativeSource={RelativeSource Self}, Converter={StaticResource WindowCommandToToolTipConverter}}" />
    </Style>

</ResourceDictionary>