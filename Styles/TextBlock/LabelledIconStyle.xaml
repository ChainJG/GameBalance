<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GameBalance.Framework.Controls"
    xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">


    <Style TargetType="{x:Type controls:LabelledIconControl}">

        <Setter Property="IconForeground" Value="{DynamicResource IconBrush}" />
        <Setter Property="IconKind" Value="Help" />
        <Setter Property="IconSize" Value="16" />

        <Setter Property="Spacing" Value="{DynamicResource SeparatorSmallRightPadding}" />
        <Setter Property="Orientation" Value="Horizontal" />

        <Setter Property="TextStyle" Value="{DynamicResource SubTitleStyle}" />
        <Setter Property="TextForeground" Value="{DynamicResource TextPrimaryBrush}" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LabelledIconControl}">

                    <StackPanel
                        x:Name="PART_Panel"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Orientation="{TemplateBinding Orientation}">

                        <materialDesign:PackIcon
                            x:Name="PART_Icon"
                            Width="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            Foreground="{TemplateBinding IconForeground}"
                            Kind="{TemplateBinding IconKind}" />

                        <TextBlock
                            x:Name="PART_Text"
                            Foreground="{TemplateBinding TextForeground}"
                            Style="{TemplateBinding TextStyle}"
                            Text="{TemplateBinding Text}" />

                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Orientation" Value="Horizontal">

                            <Setter TargetName="PART_Icon" Property="Margin" Value="{DynamicResource SeparatorSmallRightPadding}" />

                        </Trigger>

                        <Trigger Property="Orientation" Value="Vertical">

                            <Setter TargetName="PART_Icon" Property="Margin" Value="{DynamicResource SeparatorSmallBottomPadding}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>