<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="clr-namespace:GameBalance.MVVM.Utilities.Behaviors"
    xmlns:controls="clr-namespace:GameBalance.MVVM.UserControls.Shared.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:GameBalance.MVVM.Utilities.Properties">

    <Style x:Key="BaseBorderStyle" TargetType="{x:Type Border}">

        <Setter Property="CornerRadius" Value="{StaticResource BorderCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource BorderPadding}" />

        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

    </Style>

    <Style x:Key="BaseButtonBorderStyle" TargetType="{x:Type Border}">

        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />

        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

    </Style>


</ResourceDictionary>