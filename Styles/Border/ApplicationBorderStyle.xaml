<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ApplicationBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource 16CornerRadiusOuter}" />
        <Setter Property="Padding" Value="{StaticResource 16Padding}" />
    </Style>

</ResourceDictionary>